---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  lang?: "id" | "en";
  alternateHref?: string;
  alternateLang?: "id" | "en";
}

const { title, description, lang = "id", alternateHref, alternateLang } = Astro.props;
const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const ogImage = Astro.site ? new URL("/images/istano-basa-pagaruyung-hero.jpg", Astro.site).href : "/images/istano-basa-pagaruyung-hero.jpg";
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#243e34" />
    <meta name="description" content={description} />
    {canonicalURL && <link rel="canonical" href={canonicalURL.href} />}
    {alternateHref && alternateLang && <link rel="alternate" hreflang={alternateLang} href={alternateHref} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalURL && <meta property="og:url" content={canonicalURL.href} />}
    <meta property="og:image" content={ogImage} />
    <link rel="icon" href="/icons/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icons/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/icons/favicon-16.png" sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" sizes="180x180" />
    <title>{title}</title>
  </head>
  <body data-language={lang}>
    <slot />
  </body>
</html>

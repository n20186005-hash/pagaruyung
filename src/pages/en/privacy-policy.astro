---
import LegalLayout from "../../layouts/LegalLayout.astro";
import { withSiteName } from "../../data/site";

const title = withSiteName("en", "Privacy Policy");
const description = "Privacy explanation for the independent Istano Basa Pagaruyung guide, including minimal data use, third-party services, and user rights.";
---

<LegalLayout
  {title}
  {description}
  lang="en"
  alternateHref="/privacy-policy/"
  eyebrow="PRIVACY POLICY"
  heading="Minimal data, clear explanation."
  lead="This page explains what data may be processed when you use the site, why it is used, and how your Cookie choices are stored locally on your device."
>
  <section>
    <h2>Scope of data</h2>
    <p>We aim to limit data processing to what is genuinely needed to operate the site. This includes basic technical data from web requests, Cookie preferences that you save on your own device, and information that you provide voluntarily through any contact channel that may be available.</p>
    <p>This site is not designed to build commercial behavioural profiles. We do not sell personal data, create marketing segmentation, or use third-party advertising trackers.</p>
  </section>

  <section>
    <h2>Use of third-party services</h2>
    <p>Some site elements may rely on third-party services only where relevant to page function. Embedded Google Maps is used to help with location orientation. Google Analytics is loaded only if you grant analytics consent through the Cookie Settings page.</p>
    <p>If analytics consent is not granted, the analytics script is not loaded. Your choice is stored locally in the browser so that it can be respected again when you open other pages on the site.</p>
  </section>

  <section>
    <h2>Your rights and control</h2>
    <p>You can review and change your Cookie preferences at any time through the Cookie Settings page. For data that may relate to direct communication, you may request access, correction, or deletion to the extent applicable under the relevant regulations.</p>
    <p>We also recommend reviewing the privacy policies of the limited third-party services used on this site, especially if you interact with map services or choose to enable analytics.</p>
  </section>
</LegalLayout>

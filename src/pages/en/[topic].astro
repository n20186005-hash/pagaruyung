---
import TopicPage from "../../components/TopicPage.astro";
import { TOPIC_SLUGS, getTopic, getEntry } from "../../data/topics.index";

export function getStaticPaths() {
  return TOPIC_SLUGS.map((slug) => ({
    params: { topic: slug },
    props: { slug },
  }));
}

const slug = Astro.params.topic as string;
const topic = getTopic(slug, "en");
const entry = getEntry(slug);

if (!topic || !entry) {
  return Astro.redirect("/en/");
}
---

<TopicPage
  {topic}
  {slug}
  lang="en"
  group={entry.group}
  site={Astro.site}
/>

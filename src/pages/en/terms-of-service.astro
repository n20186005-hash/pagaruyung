---
import LegalLayout from "../../layouts/LegalLayout.astro";
import { withSiteName } from "../../data/site";

const title = withSiteName("en", "Terms of Service");
const description = "Terms of service for the independent Istano Basa Pagaruyung guide, including content use limits, information accuracy, and user responsibility.";
---

<LegalLayout
  {title}
  {description}
  lang="en"
  alternateHref="/terms-of-service/"
  eyebrow="TERMS OF SERVICE"
  heading="Use as a guide, not a substitute for verification."
  lead="All site content is provided as general visitor information to help orient your visit. Travel decisions, costs, access, and on-the-ground conditions still need to be verified through official sources or local staff."
>
  <section>
    <h2>Site status</h2>
    <p>This site is an independent, non-profit visitor guide. We are not an official representative of Istano Basa Pagaruyung, the local government, the site manager, or any commercial operator. Mentions of locations, services, or business categories are provided as informational context, not commercial endorsement.</p>
  </section>

  <section>
    <h2>Accuracy and updates</h2>
    <p>We aim to summarise traceable public sources. However, visiting hours, ticket prices, access rules, facilities, weather conditions, and travel situations can change at any time. You are responsible for verifying important information before departing or making travel decisions.</p>
    <p>If you find information that is no longer current, that change does not automatically imply an instant update across every page of the site.</p>
  </section>

  <section>
    <h2>Copyright and limitation of liability</h2>
    <p>Original text, presentation structure, and site design are protected by applicable copyright. Photos are subject to the licences or copyright of their respective owners as shown in the image credits.</p>
    <p>The site is provided as-is for informational purposes. We offer no warranty against losses, additional costs, or other consequences arising from the use of the information in planning or undertaking travel.</p>
  </section>
</LegalLayout>

---
import SiteFooter from "../../components/SiteFooter.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";


const title = "Istano Basa Pagaruyung & Pagaruyung Kingdom | Visitor Guide";
const description = "Explore Istano Basa Pagaruyung in Tanah Datar: how the reconstructed palace museum relates to Pagaruyung Kingdom, dated visiting hours, location and ticket advice.";
const configuredPageUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const structuredImage = Astro.site ? new URL("/images/istano-basa-pagaruyung-hero.jpg", Astro.site).href : "/images/istano-basa-pagaruyung-hero.jpg";
const mapEmbed = "https://maps.google.com/maps?q=-0.4712964,100.6214049&z=16&output=embed";

const faq = [
  { q: "When is Istano Basa Pagaruyung open?", a: "Google Maps listed 08:00–18:00 daily when checked on 19 October 2026. This is a dated listing, not a guarantee for holidays, events or maintenance; confirm with site staff before travelling." },
  { q: "How long should I allow for a visit?", a: "Allow around 1–3 hours to explore the main building, take photographs, and understand the cultural context. Add time if you are combining the visit with other cultural sites in Tanah Datar." },
  { q: "How can I get there without a private vehicle?", a: "Plan your main journey to Batusangkar first. From there, use local transport, a taxi, or an ojek for the final part of the trip. Ask about availability and fares before setting off." },
  { q: "Is there a dress code?", a: "Wear modest, comfortable clothing suited to the weather. Follow staff guidance at the site, including any instructions about footwear or restricted areas." },
  { q: "Are entrance fees and facilities always the same?", a: "No. Admission charges, costume rental, parking, and supporting facilities may change. Use information at the ticket counter and official local channels as your final reference." }
];

const attractionJsonLd = {
  "@context": "https://schema.org",
  "@type": "TouristAttraction",
  name: "Istano Basa Pagaruyung",
  description,
  image: structuredImage,
  hasMap: "https://www.google.com/maps/dir/?api=1&destination=-0.4712964,100.6214049",
  ...(configuredPageUrl ? { url: configuredPageUrl } : {}),
  address: {
    "@type": "PostalAddress",
    streetAddress: "Jl. Sutan Alam Bagagarsyah, Pagaruyung, Tanjung Emas District",
    addressLocality: "Tanah Datar Regency",
    addressRegion: "West Sumatra",
    postalCode: "27281",
    addressCountry: "ID"
  },
  geo: { "@type": "GeoCoordinates", latitude: -0.4712964, longitude: 100.6214049 }
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((item) => ({ "@type": "Question", name: item.q, acceptedAnswer: { "@type": "Answer", text: item.a } }))
};
---

<BaseLayout {title} {description} lang="en" alternateHref="/" alternateLang="id">
  <script is:inline type="application/ld+json" set:html={JSON.stringify(attractionJsonLd)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

  <header class="site-header" id="home">
    <a class="brand" href="#home" aria-label="Istano Basa Pagaruyung — Home">
      <svg class="brand-mark" viewBox="0 0 54 44" aria-hidden="true"><path d="M2 34h50M7 34V21l8-10 4 10 8-18 8 18 4-10 8 10v13M10 25h34M16 34v-7h22v7" fill="none" stroke="currentColor" stroke-width="2.7" stroke-linejoin="round" /><path d="M8 17 15 9l4 9 8-18 8 18 4-10 8 10" fill="none" stroke="#dca83a" stroke-width="2.7" stroke-linecap="round" /></svg>
      <span><b>ISTANO BASA</b><small>PAGARUYUNG · TANAH DATAR</small></span>
    </a>
    <nav class="site-nav" data-menu aria-label="Main navigation">
      <a href="#about">About</a><a href="#visit">Visit</a><a href="#access">Access</a><a href="#nearby">Nearby</a><a href="#faq">FAQ</a>
      <a class="nav-map" href="#map">View map <span>↗</span></a>
      <div class="language-switch" aria-label="Choose language"><a href="/" lang="id">ID</a><a class="active" href="/en/" aria-current="page">EN</a></div>
    </nav>
  </header>

  <main>
    <section class="hero" aria-labelledby="hero-title">
      <img class="hero-image" src="/images/istano-basa-pagaruyung-hero.jpg" alt="Istano Basa Pagaruyung with its distinctive Minangkabau gonjong roofs" />
      <div class="hero-shade"></div>
      <div class="hero-content content-wrap">
        <p class="kicker light"><span></span> TANAH DATAR · WEST SUMATRA</p>
        <h1 id="hero-title">Istano Basa<br /><em>Pagaruyung</em><br />in Tanah Datar.</h1>
        <p class="hero-text">An independent guide to Istano Basa Pagaruyung — a Minangkabau cultural space, a historical trace, and a visitor experience in the heart of Tanah Datar.</p>
        <div class="hero-actions"><a class="button gold" href="#visit">Plan your visit <span>↓</span></a><a class="text-link light" href="#about">Discover the istano <span>→</span></a></div>
      </div>
      <div class="hero-metrics"><div><strong>08:00–18:00</strong><span>Maps listing · 19 Oct 2026</span></div><div><strong>1–3 hours</strong><span>suggested exploration time</span></div><div><strong>4.7 / 5</strong><span>Google Maps · 17,759 reviews · 19 Oct 2026</span></div></div>
      <p class="hero-credit">Photo: Adhmi / Wikimedia Commons · CC BY-SA 4.0</p>
    </section>

    <section id="about" class="intro-section content-wrap section-spacing">
      <div class="section-label"><span>01</span> AN ISTANO, NOT JUST A BUILDING</div>
      <div class="intro-grid"><div><h2>Where custom, governance, and memory meet.</h2></div><div class="body-copy"><p>The historical Pagaruyung Kingdom and the building visited today are different subjects. Indonesia Travel describes today’s Istano Basa Pagaruyung as a reconstructed palace and specialized museum in Tanah Datar, West Sumatra. It offers context for Minangkabau heritage rather than an intact palace surviving unchanged from the kingdom.</p><p>Use the museum visit as an introduction to Rumah Gadang architecture and the region’s cultural history; the museum and the wider kingdom’s history should not be treated as interchangeable.</p></div></div>
      <div class="photo-split"><figure class="large"><img src="/images/rumah-gadang-detail.jpg" alt="Façade and roof detail of a Rumah Gadang at Istano Basa Pagaruyung" /><figcaption>Rumah Gadang architecture: the gonjong roof form recalls buffalo horns in Minangkabau tradition.</figcaption></figure><div class="history-card"><p class="eyebrow">THROUGH TIME</p><h3>Lost to fire, rebuilt, and continuously cared for.</h3><ol><li><b>27 December 1976</b><span>Indonesia Travel dates the main-pillar construction ceremony at the present reconstruction site to this day.</span></li><li><b>2007</b><span>The Vice-President’s Office records a fire on 27 February and reconstruction beginning on 8 July.</span></li><li><b>October 2013</b><span>The reconstructed museum reopened, according to the Vice-President’s Office account.</span></li></ol><p class="source-note"><a href="https://www.indonesia.travel/gb/en/destination/sumatra/west-sumatra/istano-basa-pagaruyung-minangkabau-cultural-heritage">Indonesia Travel</a> · <a href="https://wapresri.go.id/kearifan-masa-lalu-modal-kejayaan-masa-depan/">Vice-President’s Office</a> · sources checked 19 October 2026.</p></div></div>
    </section>

    <section id="visit" class="visit-section section-spacing"><div class="content-wrap"><div class="section-label light"><span>02</span> VISITOR GUIDE</div><div class="visit-heading"><h2>Arrive curious,<br /><em>leave with context.</em></h2><p>Use this section as an initial orientation. On-site operations may change; verify important information before your journey.</p></div><div class="visit-cards"><article><span class="icon">◷</span><h3>Best time</h3><p>Morning light is gentler for seeing the gonjong forms and walking around the grounds. Arrive early if you prefer a quieter rhythm of visit.</p></article><article><span class="icon">◎</span><h3>Suggested duration</h3><p>Set aside 1–3 hours for the main building, the outdoor area, photographs, and cultural context. Add time if you are continuing to Batusangkar or nearby sites.</p></article><article><span class="icon">Rp</span><h3>Tickets & costs</h3><p>Admission fees and supporting services can change. Check the information board and ticket counter on the day; do not rely solely on old travel-blog prices.</p></article><article><span class="icon">↟</span><h3>At the istano</h3><p>Dress modestly, follow staff directions, and respect restricted areas. Indonesia Travel describes traditional costume experiences; ask staff whether this service is available today, and confirm prices and any booking requirements.</p></article></div></div></section>

    <p class="source-note">Google Maps snapshot checked 19 October 2026: daily 08:00–18:00, 4.7/5 from 17,759 reviews; phone <a href="tel:+628217635177">+62 821 7635 177</a> is listed by Maps. These are dated third-party details, not operator confirmation. Current entrance and costume-service prices are unverified; check with the ticket counter. <a href="https://maps.app.goo.gl/RqqYs1bsjPJaDFB66">View Maps listing</a>.</p>
    <section id="access" class="access-section content-wrap section-spacing"><div class="section-label"><span>03</span> REACHING PAGARUYUNG</div><div class="access-grid"><div><h2>The journey ends in Batusangkar; from there, the istano is close.</h2><p class="body-copy lead">The istano is in Nagari Pagaruyung, Tanjung Emas District, Tanah Datar Regency. Plan the main part of your journey to Batusangkar first, then arrange transport for the final stage.</p><a class="button dark" href="#map">Open location in map <span>↘</span></a></div><div class="route-list"><article><span>01</span><div><h3>From the airport</h3><p>Minangkabau International Airport is an air gateway to the Padang area. Continue to Tanah Datar by scheduled ground transport, a hired vehicle, or a pre-arranged journey. Check route conditions and travel time when planning.</p></div></article><article><span>02</span><div><h3>Bus & local transport</h3><p>For a lower-cost option, look for transport to Batusangkar from connecting towns such as Padang Panjang or Bukittinggi. Local schedules can change, so ask directly about destination and departure time.</p></div></article><article><span>03</span><div><h3>Taxi, ojek & hired car</h3><p>From Batusangkar, continue by taxi, ojek, or a hired vehicle. Agree on the destination, fare, and waiting time before the trip, especially if you need to return to town on the same day.</p></div></article></div></div><div class="facility-strip"><div><b>Parking</b><span>Follow parking-area directions and on-site staff guidance.</span></div><div><b>Toilets</b><span>Ask for the location of public facilities when you arrive.</span></div><div><b>Food & drinks</b><span>Ask staff about food options available on the day.</span></div><div><b>Travel essentials</b><span>If you need accommodation, supplies or fuel, check operator locations and opening hours along your planned route.</span></div></div></section>

    <section id="map" class="map-section"><div class="map-copy"><p class="section-label light"><span>04</span> FIND THE LOCATION</p><h2>Istano Basa<br />Pagaruyung</h2><p>Jl. Sutan Alam Bagagarsyah<br />Pagaruyung, Tanjung Emas District<br />Tanah Datar Regency, West Sumatra 27281</p><a href="https://www.google.com/maps/dir/?api=1&destination=-0.4712964,100.6214049" target="_blank" rel="noreferrer">Get directions <span>↗</span></a></div><iframe src={mapEmbed} title="Map location of Istano Basa Pagaruyung" width="600" height="450" style="border:0" allowfullscreen loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe></section>

    <section id="nearby" class="around-section content-wrap section-spacing"><div class="section-label"><span>05</span> CONTINUE EXPLORING</div><div class="around-heading"><h2>Tanah Datar does not end<br />on one page.</h2><p>Build a visit that brings together culture, landscape, and time to enjoy local food. The names below are area context and destination categories, not commercial endorsements.</p></div><div class="around-grid"><article class="feature-card"><img src="/images/istana-pagaruyung-detail.jpg" alt="Istano Basa Pagaruyung viewed from another angle" /><div><p class="eyebrow">CULTURE NEARBY</p><h3>Pagaruyung Inscription Site</h3><p>Add the inscription site for a deeper reading of the kingdom’s history in the Pagaruyung area.</p></div></article><div class="nearby-list"><article><span>01</span><div><h3>Istano Silinduang Bulan</h3><p>Another Rumah Gadang in the Pagaruyung area, offering additional architectural and local historical context.</p></div></article><article><span>02</span><div><h3>Batusangkar</h3><p>Use the town as a stop for travel needs, meals, accommodation, and onward access to Tanah Datar attractions.</p></div></article><article><span>03</span><div><h3>Lake Singkarak & Minangkabau landscapes</h3><p>If your route allows, continue to other natural and cultural destinations in West Sumatra. Check weather and access before departure.</p></div></article></div></div><div class="food-guide"><div><p class="eyebrow">NEUTRAL OPTIONS</p><h3>For a pause on the road</h3></div><p><b>Food:</b> look for Minang restaurants, local food stalls, traditional snacks, or drinks that suit your preferences and dietary needs.</p><p><b>Stay:</b> consider a hotel, guesthouse, or homestay in Batusangkar if you would like to explore Tanah Datar at a slower pace.</p><p><b>Small supplies:</b> choose markets, kiosks, or everyday shops for drinking water and travel basics. Do not rely on a single named business.</p></div></section>

    <section class="gallery-section"><div class="content-wrap"><div class="section-label light"><span>06</span> READING THE DETAIL</div><h2>Wood, line, sky,<br />and a living heritage.</h2><div class="gallery-grid"><figure><img src="/images/istano-rajo-basa.jpg" alt="Istano Basa Pagaruyung viewed from the outdoor grounds" /><figcaption>The istano’s outdoor space and roofline silhouette.</figcaption></figure><figure><img src="/images/rumah-gadang-detail.jpg" alt="Rumah Gadang detail at Istano Basa Pagaruyung" /><figcaption>Ornament and structure of the Rumah Gadang.</figcaption></figure></div><div class="image-credits"><p class="eyebrow">PHOTO CREDITS</p><ul><li><a href="https://commons.wikimedia.org/wiki/File:Istano_Basa_Pagaruyung.jpg" target="_blank" rel="noreferrer">Istano Basa Pagaruyung</a> — Adhmi, CC BY-SA 4.0.</li><li><a href="https://commons.wikimedia.org/wiki/File:Rumah_Gadang,_Istano_Basa_Pagaruyung.jpg" target="_blank" rel="noreferrer">Rumah Gadang, Istano Basa Pagaruyung</a> — Ichan.dgmc, CC BY-SA 4.0.</li><li><a href="https://commons.wikimedia.org/wiki/File:Istana_Pagaruyung_17.jpg" target="_blank" rel="noreferrer">Istana Pagaruyung 17</a> — Indonesia Ministry of Public Works, public domain.</li><li><a href="https://commons.wikimedia.org/wiki/File:Istano_Rajo_Basa_Pagaruyung.jpg" target="_blank" rel="noreferrer">Istano Rajo Basa Pagaruyung</a> — Herusutimbul, CC BY-SA 4.0.</li></ul></div></div></section>

    <section id="faq" class="faq-section content-wrap section-spacing"><div class="section-label"><span>07</span> FREQUENTLY ASKED QUESTIONS</div><div class="faq-grid"><h2>Questions often asked before the trip.</h2><div class="faq-list">{faq.map((item) => <details><summary>{item.q}<span>+</span></summary><p>{item.a}</p></details>)}</div></div></section>
  </main>

  <SiteFooter lang="en" />

  <script is:inline>
    const menuButton = document.querySelector("[data-menu-button]");
    const menu = document.querySelector("[data-menu]");
    menuButton?.addEventListener("click", () => { const open = menu.classList.toggle("open"); menuButton.setAttribute("aria-expanded", String(open)); });
    menu?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => { menu.classList.remove("open"); menuButton?.setAttribute("aria-expanded", "false"); }));
  </script>
</BaseLayout>

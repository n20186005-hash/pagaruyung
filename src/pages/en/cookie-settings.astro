---
import CookieSettingsForm from "../../components/CookieSettingsForm.astro";
import LegalLayout from "../../layouts/LegalLayout.astro";

const title = "Cookie Settings | Istano Basa Pagaruyung";
const description = "Cookie settings page for managing analytics consent and local preferences on the Istano Basa Pagaruyung guide site.";
---

<LegalLayout
  {title}
  {description}
  lang="en"
  alternateHref="/cookie-settings/"
  eyebrow="COOKIE SETTINGS"
  heading="You decide."
  lead="This page provides consent controls stored directly in your browser. Essential storage is required so that your preference can continue to apply when you return to the site."
>
  <section>
    <h2>How consent works</h2>
    <p>By default, the site relies only on essential storage to remember your choice. Analytics does not load unless you switch it on yourself. No marketing Cookies are used.</p>
  </section>

  <section>
    <CookieSettingsForm lang="en" />
  </section>
</LegalLayout>

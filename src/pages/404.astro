---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteFooter from "../components/SiteFooter.astro";

const title = "Halaman tidak ditemukan (404) — Istano Basa Pagaruyung";
const description = "Halaman yang Anda cari tidak tersedia. Kembali ke panduan pengunjung Istano Basa Pagaruyung.";
---

<BaseLayout {title} {description} lang="id" noindex>
  <main class="content-wrap section-spacing" style="min-height: 60vh; display: flex; flex-direction: column; justify-content: center; text-align: center; gap: 1rem;">
    <p class="section-label" style="justify-content: center;"><span>404</span> HALAMAN TIDAK DITEMUKAN</p>
    <h1 style="font-size: clamp(1.8rem, 5vw, 2.6rem); line-height: 1.1;">Halaman ini tidak dapat ditemukan.</h1>
    <p class="body-copy lead" style="max-width: 46ch; margin-inline: auto;">Tautan mungkin sudah berubah atau halaman telah dipindahkan. Gunakan navigasi di bawah untuk kembali ke panduan utama.</p>
    <div style="display: flex; gap: 0.75rem; justify-content: center; flex-wrap: wrap;">
      <a class="button gold" href="/">Kembali ke panduan <span>→</span></a>
      <a class="text-link" href="/en/">English version <span>→</span></a>
    </div>
  </main>

  <SiteFooter lang="id" />
</BaseLayout>
